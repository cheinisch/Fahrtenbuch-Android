<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: Cloud-Backup (Google) und Gerätewechsel. Gleiche Auswahl wie backup_rules.xml:
  Datenbank und Einstellungen, nie fahrtenbuch_device.xml (Tokens, Geräte-ID).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="fahrtenbuch-offline.db" />
        <include domain="sharedpref" path="fahrtenbuch_session.xml" />
        <include domain="sharedpref" path="fahrtenbuch_theme.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="fahrtenbuch-offline.db" />
        <include domain="sharedpref" path="fahrtenbuch_session.xml" />
        <include domain="sharedpref" path="fahrtenbuch_theme.xml" />
    </device-transfer>
</data-extraction-rules>
